<Application
    x:Class="MyMusic.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls"/>
            </ResourceDictionary.MergedDictionaries>
            <SolidColorBrush x:Key="AccentBrush" Color="#1DB954"/>
            <SolidColorBrush x:Key="AccentLightBrush" Color="#5DDC84"/>
            <SolidColorBrush x:Key="AccentDarkBrush" Color="#16883D"/>
            <SolidColorBrush x:Key="AppBackgroundBrush" Color="#0B0C0F"/>
            <SolidColorBrush x:Key="SidebarBrush" Color="#111318"/>
            <SolidColorBrush x:Key="SurfaceBrush" Color="#15171C"/>
            <SolidColorBrush x:Key="Surface2Brush" Color="#191B21"/>
            <SolidColorBrush x:Key="Surface3Brush" Color="#22252D"/>
            <SolidColorBrush x:Key="SectionHoverBrush" Color="#252A32"/>
            <SolidColorBrush x:Key="SectionActiveBrush" Color="#2B3039"/>
            <SolidColorBrush x:Key="SectionBorderBrush" Color="#3A414D"/>
            <SolidColorBrush x:Key="PrimaryTextBrush" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="SecondaryTextBrush" Color="#A8ADB9"/>
            <SolidColorBrush x:Key="MutedTextBrush" Color="#858A96"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
