<?xml version='1.0' encoding='UTF-8'?>
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" x:Class="MyMusic.MainWindow" mc:Ignorable="d" Title="MyMusic">
    <Grid x:Name="Root" Background="{ThemeResource AppBackgroundBrush}" PointerMoved="OnRootPointerMoved" KeyDown="OnRootKeyDown">
        <Grid.Resources>
            <!-- Override WinUI TextBox chrome at resource scope. Resources cannot be set
                 through a Style Setter, which caused WMC0095 in Fixed 46. -->
            <SolidColorBrush x:Key="TextControlBackground" Color="Transparent"/>
            <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent"/>
            <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent"/>
            <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="Transparent"/>
            <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent"/>
            <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent"/>
            <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent"/>
            <SolidColorBrush x:Key="TextControlBorderBrushDisabled" Color="Transparent"/>
            <Style x:Key="FlatButton" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Foreground" Value="{ThemeResource SecondaryTextBrush}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal"/>
                                        <VisualState x:Name="PointerOver">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ButtonBorder" Storyboard.TargetProperty="Background">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource SectionHoverBrush}"/>
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ButtonBorder" Storyboard.TargetProperty="Background">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource SectionActiveBrush}"/>
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Disabled"/>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" Padding="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <!-- Used for the two controls that should keep their existing appearance on hover. -->
            <Style x:Key="NoHoverButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}">
                                <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" Padding="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="ViewModeButton" TargetType="Button" BasedOn="{StaticResource NoHoverButton}">
                <Setter Property="Background" Value="{ThemeResource Surface2Brush}"/>
                <Setter Property="Foreground" Value="{ThemeResource SecondaryTextBrush}"/>
                <Setter Property="Padding" Value="10,6"/>
                <Setter Property="CornerRadius" Value="16"/>
            </Style>
            <Style x:Key="SearchTextBox" TargetType="TextBox">
                <!-- Keep WinUI's complete TextBox template so editing/selection/placeholder
                     behavior stays correct, but override every stock fill/border brush. -->
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Foreground" Value="{ThemeResource PrimaryTextBrush}"/>
                <!-- WinUI's font metrics render this font a few pixels above the visual
                     center. The asymmetric padding intentionally lowers the baseline. -->
                <Setter Property="Padding" Value="4,10,4,0"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            </Style>
            <Style x:Key="CardButton" TargetType="Button" BasedOn="{StaticResource FlatButton}"><Setter Property="Foreground" Value="{ThemeResource PrimaryTextBrush}"/><Setter Property="HorizontalContentAlignment" Value="Left"/></Style>
            <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource FlatButton}"><Setter Property="Width" Value="32"/><Setter Property="Height" Value="32"/><Setter Property="Foreground" Value="{ThemeResource SecondaryTextBrush}"/><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
            <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource FlatButton}"><Setter Property="Background" Value="{ThemeResource AccentBrush}"/><Setter Property="Foreground" Value="White"/><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
            <Style x:Key="SortButton" TargetType="Button" BasedOn="{StaticResource FlatButton}"><Setter Property="Background" Value="{ThemeResource Surface2Brush}"/><Setter Property="Foreground" Value="{ThemeResource SecondaryTextBrush}"/><Setter Property="Padding" Value="10,6"/><Setter Property="CornerRadius" Value="16"/></Style>
            <Style x:Key="ArtistButton" TargetType="Button" BasedOn="{StaticResource NoHoverButton}"><Setter Property="Foreground" Value="{ThemeResource MutedTextBrush}"/><Setter Property="HorizontalContentAlignment" Value="Left"/></Style>
            <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
                <Setter Property="Padding" Value="16,14"/>
                <Setter Property="MinHeight" Value="52"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="CornerRadius" Value="10"/>
            </Style>
            <Style x:Key="SmallAction" TargetType="Button" BasedOn="{StaticResource FlatButton}">
                <Setter Property="Background" Value="{ThemeResource Surface2Brush}"/>
                <Setter Property="Foreground" Value="{ThemeResource PrimaryTextBrush}"/>
                <Setter Property="Padding" Value="12,9"/>
                <Setter Property="CornerRadius" Value="8"/>
            </Style>
            <Style TargetType="ScrollBar">
                <Setter Property="Width" Value="10"/>
                <Setter Property="MinWidth" Value="10"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{ThemeResource AccentBrush}"/>
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="112"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="226"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border x:Name="Sidebar" Grid.Row="0" Grid.Column="0" Background="{ThemeResource SidebarBrush}" BorderBrush="{ThemeResource AccentBrush}" BorderThickness="0,2,0,0" Padding="18,22">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBlock Text="MyMusic" FontSize="25" FontWeight="SemiBold" Foreground="{ThemeResource PrimaryTextBrush}" Margin="6,0,0,26"/>
                <StackPanel Grid.Row="1" Spacing="3">
                    <Button x:Name="HomeNav" Style="{StaticResource NavButton}" Click="OnHomeNavigation" PointerEntered="OnNavHover" PointerExited="OnNavUnhover"><StackPanel Orientation="Horizontal" Spacing="15"><FontIcon Glyph="" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="{ThemeResource SecondaryTextBrush}"/><TextBlock Text="Home" FontSize="18" VerticalAlignment="Center"/></StackPanel></Button>
                    <Button x:Name="SearchNav" Style="{StaticResource NavButton}" Click="OnSearchNavigation" PointerEntered="OnNavHover" PointerExited="OnNavUnhover"><StackPanel Orientation="Horizontal" Spacing="15"><FontIcon Glyph="" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="{ThemeResource SecondaryTextBrush}"/><TextBlock Text="Search" FontSize="18" VerticalAlignment="Center"/></StackPanel></Button>
                    <TextBlock Text="LIBRARY" Foreground="{ThemeResource MutedTextBrush}" FontSize="10" FontWeight="SemiBold" Margin="14,20,0,6"/>
                    <Button x:Name="SongsNav" Style="{StaticResource NavButton}" Click="OnSongsNavigation" PointerEntered="OnNavHover" PointerExited="OnNavUnhover"><StackPanel Orientation="Horizontal" Spacing="15"><FontIcon Glyph="" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="{ThemeResource SecondaryTextBrush}"/><TextBlock Text="Songs" FontSize="18" VerticalAlignment="Center"/></StackPanel></Button>
                    <Button x:Name="AlbumsNav" Style="{StaticResource NavButton}" Click="OnAlbumsNavigation" PointerEntered="OnNavHover" PointerExited="OnNavUnhover"><StackPanel Orientation="Horizontal" Spacing="15"><FontIcon Glyph="" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="{ThemeResource SecondaryTextBrush}"/><TextBlock Text="Albums" FontSize="18" VerticalAlignment="Center"/></StackPanel></Button>
                    <Button x:Name="ArtistsNav" Style="{StaticResource NavButton}" Click="OnArtistsNavigation" PointerEntered="OnNavHover" PointerExited="OnNavUnhover"><StackPanel Orientation="Horizontal" Spacing="15"><FontIcon Glyph="" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="{ThemeResource SecondaryTextBrush}"/><TextBlock Text="Artists" FontSize="18" VerticalAlignment="Center"/></StackPanel></Button>
                    <Button x:Name="PlaylistsNav" Style="{StaticResource NavButton}" Click="OnPlaylistsNavigation" PointerEntered="OnNavHover" PointerExited="OnNavUnhover"><StackPanel Orientation="Horizontal" Spacing="15"><FontIcon Glyph="" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="{ThemeResource SecondaryTextBrush}"/><TextBlock Text="Playlists" FontSize="18" VerticalAlignment="Center"/></StackPanel></Button>
                </StackPanel>
                <StackPanel Grid.Row="2" Spacing="3">
                    <Button Style="{StaticResource NavButton}" Click="OnRefreshLibrary"><StackPanel Orientation="Horizontal" Spacing="15"><FontIcon Glyph="" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="{ThemeResource SecondaryTextBrush}"/><TextBlock Text="Refresh library" FontSize="18" VerticalAlignment="Center"/></StackPanel></Button>
                    <Button Style="{StaticResource NavButton}" Click="OnSettings"><StackPanel Orientation="Horizontal" Spacing="15"><FontIcon Glyph="" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="{ThemeResource SecondaryTextBrush}"/><TextBlock Text="Settings" FontSize="18" VerticalAlignment="Center"/></StackPanel></Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main content -->
        <Grid Grid.Row="0" Grid.Column="1" Padding="28,22,26,18" AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center" Margin="0,0,0,20">
                <Button Style="{StaticResource FlatButton}" Click="OnBack" Width="34" Height="34"><FontIcon Glyph="" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{ThemeResource SecondaryTextBrush}"/></Button>
                <Grid Grid.Column="1" Margin="12,0,0,0">
                    <TextBlock x:Name="PageTitle" Text="Home" FontSize="30" FontWeight="SemiBold" Foreground="{ThemeResource PrimaryTextBrush}"/>
                    <Border x:Name="SearchShell" Width="440" Height="40" Visibility="Collapsed" Background="{ThemeResource Surface2Brush}" BorderBrush="{ThemeResource AccentLightBrush}" BorderThickness="1" CornerRadius="20" Padding="12,0">
                        <Grid ColumnDefinitions="24,*">
                            <FontIcon Glyph="" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{ThemeResource AccentBrush}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            <TextBox x:Name="SearchBox" Style="{StaticResource SearchTextBox}" Grid.Column="1" Height="38" VerticalAlignment="Center" TextChanged="OnSearchChanged" PlaceholderText="Search songs, albums, artists and playlists" Background="Transparent" Foreground="{ThemeResource PrimaryTextBrush}" BorderThickness="0" VerticalContentAlignment="Center"/>
                        </Grid>
                    </Border>
                </Grid>
                
            </Grid>

            <ScrollViewer x:Name="MainContentScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="22">
                    <StackPanel x:Name="HomePanel" Spacing="18">
                        <TextBlock Text="Pick up where you left off" FontSize="24" FontWeight="SemiBold" Foreground="{ThemeResource PrimaryTextBrush}"/>
                        <ItemsControl x:Name="RecentList">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="4"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate><DataTemplate>
                                <Button Click="OnRecentClick" Tag="{Binding}" Style="{StaticResource CardButton}" Width="196" Margin="0,0,14,0">
                                    <StackPanel Width="196" Spacing="9">
                                        <Border Width="168" Height="168" CornerRadius="10" Background="{ThemeResource Surface3Brush}">
                                            <Grid x:Name="HomeCardCoverGrid" RowDefinitions="*,*" ColumnDefinitions="*,*" Loaded="OnHomeCardCoverLoaded"/>
                                        </Border>
                                        <TextBlock Text="{Binding Title}" Foreground="{ThemeResource PrimaryTextBrush}" FontSize="16" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Subtitle}" Foreground="{ThemeResource MutedTextBrush}" FontSize="16" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Button>
                            </DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="Recently added" FontSize="21" FontWeight="SemiBold" Foreground="{ThemeResource PrimaryTextBrush}" Margin="0,6,0,0"/>
                    </StackPanel>

                    <Grid x:Name="TrackSortHeader" Visibility="Collapsed" Margin="0,0,0,4" ColumnDefinitions="44,2*,1.4*,1.4*,70,42" Padding="7,6">
                        <Button Grid.Column="1" Tag="Title" Click="OnTrackColumnSort" Style="{StaticResource FlatButton}" HorizontalContentAlignment="Left"><TextBlock x:Name="TrackTitleHeaderText" Text="Title ↑" Foreground="{ThemeResource MutedTextBrush}" FontSize="12" FontWeight="SemiBold"/></Button>
                        <Button Grid.Column="2" Tag="Artist" Click="OnTrackColumnSort" Style="{StaticResource FlatButton}" HorizontalContentAlignment="Left"><TextBlock x:Name="TrackArtistHeaderText" Text="Artist" Foreground="{ThemeResource MutedTextBrush}" FontSize="12" FontWeight="SemiBold"/></Button>
                        <Button Grid.Column="3" Tag="Album" Click="OnTrackColumnSort" Style="{StaticResource FlatButton}" HorizontalContentAlignment="Left"><TextBlock x:Name="TrackAlbumHeaderText" Text="Album" Foreground="{ThemeResource MutedTextBrush}" FontSize="12" FontWeight="SemiBold"/></Button>
                        <Button Grid.Column="4" Tag="Duration" Click="OnTrackColumnSort" Style="{StaticResource FlatButton}" HorizontalContentAlignment="Right"><TextBlock x:Name="TrackDurationHeaderText" Text="Duration" Foreground="{ThemeResource MutedTextBrush}" FontSize="12" FontWeight="SemiBold"/></Button>
                    </Grid>
                    <ItemsControl x:Name="TrackList">
                        <ItemsControl.ItemTemplate><DataTemplate>
                            <Grid Padding="7" Margin="0,1" ColumnDefinitions="44,2*,1.4*,1.4*,70,42" Tapped="OnTrackTapped">
                                <Border Width="38" Height="38" CornerRadius="5" Background="{ThemeResource Surface2Brush}"><Image Source="{Binding ArtworkUri}" Stretch="UniformToFill"/></Border>
                                <TextBlock Grid.Column="1" Margin="12,0,0,0" Text="{Binding Title}" Foreground="{ThemeResource PrimaryTextBrush}" FontSize="16" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" PointerEntered="OnLinkTextHover" PointerExited="OnLinkTextUnhover"/>
                                <Button Grid.Column="2" Tag="{Binding}" Click="OnArtistClick" PointerEntered="OnArtistHover" PointerExited="OnArtistUnhover" Style="{StaticResource ArtistButton}" Padding="0" Height="36" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"><TextBlock Text="{Binding Artist}" Foreground="{ThemeResource MutedTextBrush}" FontSize="15" TextTrimming="CharacterEllipsis"/></Button>
                                <Button Grid.Column="3" Tag="{Binding}" Click="OnAlbumClick" PointerEntered="OnArtistHover" PointerExited="OnArtistUnhover" Style="{StaticResource NoHoverButton}" Padding="0" Height="36" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"><TextBlock Text="{Binding Album}" Foreground="{ThemeResource MutedTextBrush}" FontSize="15" TextTrimming="CharacterEllipsis"/></Button>
                                <TextBlock Grid.Column="4" Text="{Binding DurationText}" Foreground="{ThemeResource MutedTextBrush}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                <Button Grid.Column="5" Style="{StaticResource IconButton}" Tag="{Binding}" Click="OnTrackMenu" Width="36" Height="36"><FontIcon Glyph="" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{ThemeResource SecondaryTextBrush}"/></Button>
                            </Grid>
                        </DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel x:Name="CollectionViewControls" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="4" Margin="0,0,0,10" Visibility="Collapsed">
                        <Button x:Name="CollectionTileButton" Tag="Tiles" Style="{StaticResource ViewModeButton}" Click="OnCollectionViewMode"><FontIcon Glyph="" FontFamily="Segoe MDL2 Assets" FontSize="16"/></Button>
                        <Button x:Name="CollectionListButton" Tag="List" Style="{StaticResource ViewModeButton}" Click="OnCollectionViewMode"><FontIcon Glyph="" FontFamily="Segoe MDL2 Assets" FontSize="16"/></Button>
                    </StackPanel>
                    <ItemsControl x:Name="CollectionList" Visibility="Collapsed">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="4"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate><DataTemplate>
                            <Button Tag="{Binding Name}" Click="OnCollectionButtonClick" Style="{StaticResource CardButton}" Width="196" Height="228" Margin="0,0,16,16">
                                <Border Width="196" Height="228" Background="{ThemeResource SurfaceBrush}" CornerRadius="14" Padding="14">
                                    <StackPanel Spacing="10">
                                        <Border Width="168" Height="168" CornerRadius="10" Background="{ThemeResource Surface3Brush}"><Grid x:Name="CollectionTileCoverGrid" RowDefinitions="*,*" ColumnDefinitions="*,*" Loaded="OnCollectionCoverLoaded"/></Border>
                                        <TextBlock Text="{Binding Name}" Foreground="{ThemeResource PrimaryTextBrush}" FontSize="16" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding CountText}" Foreground="{ThemeResource MutedTextBrush}" FontSize="11"/>
                                    </StackPanel>
                                </Border>
                            </Button>
                        </DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel x:Name="CollectionListHeader" Visibility="Collapsed" Margin="0,0,0,4">
                        <Grid ColumnDefinitions="64,2*,*,*,*,Auto" Padding="10,7" ColumnSpacing="12">
                            <Button Grid.Column="1" Tag="Name" Click="OnCollectionCardSort" Style="{StaticResource FlatButton}" HorizontalContentAlignment="Left"><TextBlock x:Name="CollectionTitleHeaderText" Text="Title ↑" Foreground="{ThemeResource MutedTextBrush}" FontSize="12" FontWeight="SemiBold"/></Button>
                            <Button Grid.Column="2" Tag="Count" Click="OnCollectionCardSort" Style="{StaticResource FlatButton}" HorizontalContentAlignment="Left"><TextBlock x:Name="CollectionCountHeaderText" Text="Songs" Foreground="{ThemeResource MutedTextBrush}" FontSize="12" FontWeight="SemiBold"/></Button>
                            <Button Grid.Column="3" Tag="Duration" Click="OnCollectionCardSort" Style="{StaticResource FlatButton}" HorizontalContentAlignment="Left"><TextBlock x:Name="CollectionDurationHeaderText" Text="Duration" Foreground="{ThemeResource MutedTextBrush}" FontSize="12" FontWeight="SemiBold"/></Button>
                            <TextBlock Grid.Column="4" Text="Created" Foreground="{ThemeResource MutedTextBrush}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                    <ListView x:Name="CollectionListView" Visibility="Collapsed" Background="Transparent" SelectionMode="None" HorizontalContentAlignment="Stretch">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0"/>
                                <Setter Property="Background" Value="Transparent"/>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate><DataTemplate>
                            <Button Tag="{Binding Name}" Click="OnCollectionButtonClick" Style="{StaticResource CardButton}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="0" Margin="0,3">
                                <Border HorizontalAlignment="Stretch" Background="{ThemeResource SurfaceBrush}" BorderBrush="{ThemeResource Surface3Brush}" BorderThickness="1" CornerRadius="10" Padding="10">
                                    <Grid ColumnDefinitions="64,2*,*,*,*,Auto" ColumnSpacing="12" HorizontalAlignment="Stretch">
                                        <Border Width="56" Height="56" CornerRadius="8" Background="{ThemeResource Surface3Brush}"><Grid x:Name="CollectionListCoverGrid" RowDefinitions="*,*" ColumnDefinitions="*,*" Loaded="OnCollectionCoverLoaded"/></Border>
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="{ThemeResource PrimaryTextBrush}" FontSize="15" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="2" Text="{Binding CountText}" Foreground="{ThemeResource MutedTextBrush}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="3" Text="{Binding DurationText}" Foreground="{ThemeResource MutedTextBrush}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="4" Text="{Binding CreatedText}" Foreground="{ThemeResource MutedTextBrush}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        <FontIcon Grid.Column="5" Glyph="" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{ThemeResource MutedTextBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    </Grid>
                                </Border>
                            </Button>
                        </DataTemplate></ListView.ItemTemplate>
                    </ListView>

                    <Border x:Name="DetailPanel" Visibility="Collapsed" Background="{ThemeResource SurfaceBrush}" CornerRadius="16" Padding="24">
                        <StackPanel Spacing="18">
                            <Grid ColumnDefinitions="220,*,Auto">
                                <Border Width="210" Height="210" CornerRadius="12" Background="{ThemeResource Surface3Brush}"><Grid x:Name="PlaylistCoverGrid" RowDefinitions="*,*" ColumnDefinitions="*,*"/></Border>
                                <StackPanel Grid.Column="1" Margin="24,0,20,0" VerticalAlignment="Center" Spacing="7">
                                    <TextBlock x:Name="DetailType" Text="ALBUM" Foreground="{ThemeResource AccentBrush}" FontSize="11" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="DetailTitle" Text="" Foreground="{ThemeResource PrimaryTextBrush}" FontSize="30" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="DetailSubtitle" Text="" Foreground="{ThemeResource MutedTextBrush}" FontSize="13"/>
                                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                                        <Button x:Name="PlaylistPlayButton" Style="{StaticResource AccentButton}" Click="OnPlaylistPlay" Width="42" Height="42" CornerRadius="21"><FontIcon Glyph="" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{ThemeResource PrimaryTextBrush}"/></Button>
                                        <Button x:Name="PlaylistShuffleButton" Style="{StaticResource IconButton}" Click="OnPlaylistShuffle" Width="38" Height="38"><FontIcon Glyph="" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{ThemeResource SecondaryTextBrush}"/></Button>
                                        <Ellipse x:Name="PlaylistShuffleDot" Width="5" Height="5" Fill="{ThemeResource AccentBrush}" VerticalAlignment="Bottom" Margin="-3,0,0,7" Visibility="Collapsed"/>
                                        <Button x:Name="PlaylistRepeatButton" Style="{StaticResource IconButton}" Click="OnPlaylistRepeat" Width="38" Height="38"><FontIcon Glyph="" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{ThemeResource SecondaryTextBrush}"/></Button>
                                        <Ellipse x:Name="PlaylistRepeatDot" Width="5" Height="5" Fill="{ThemeResource AccentBrush}" VerticalAlignment="Bottom" Margin="-3,0,0,7" Visibility="Collapsed"/>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="2" VerticalAlignment="Top" Spacing="6">
                                    <StackPanel x:Name="PlaylistCoverActions" Orientation="Horizontal" Spacing="6" Visibility="Collapsed">
                                        <Button Style="{StaticResource SmallAction}" Click="OnPlaylistCover"><TextBlock Text="Change cover"/></Button>
                                        <Button Style="{StaticResource SmallAction}" Click="OnPlaylistCoverFromTrack"><TextBlock Text="Use song cover"/></Button>
                                        <Button Style="{StaticResource SmallAction}" Click="OnPlaylistDefaultCover"><TextBlock Text="Use 4-cover"/></Button>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                            <StackPanel x:Name="DetailSortBar" Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="Sort" Foreground="{ThemeResource MutedTextBrush}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <Button x:Name="CustomSortButton" Tag="Custom" Style="{StaticResource SortButton}" Click="OnCollectionSort"><TextBlock Text="Custom"/></Button>
                                <Button Tag="Duration" Style="{StaticResource SortButton}" Click="OnCollectionSort"><TextBlock Text="Duration"/></Button>
                                <Button Tag="Name" Style="{StaticResource SortButton}" Click="OnCollectionSort"><TextBlock Text="Name"/></Button>
                                <Button Tag="Artist" Style="{StaticResource SortButton}" Click="OnCollectionSort"><TextBlock Text="Artist"/></Button>
                                
                            </StackPanel>
                            <StackPanel x:Name="PlaylistControls" Visibility="Collapsed"/>
                            <Grid x:Name="DetailTrackSortHeader" Visibility="Collapsed" Margin="0,0,0,4" ColumnDefinitions="44,2*,1.4*,1.4*,70,42" Padding="7,6">
                                <Button Grid.Column="1" Tag="Title" Click="OnTrackColumnSort" Style="{StaticResource FlatButton}" HorizontalContentAlignment="Left"><TextBlock x:Name="DetailTrackTitleHeaderText" Text="Title ↑" Foreground="{ThemeResource MutedTextBrush}" FontSize="12" FontWeight="SemiBold"/></Button>
                                <Button Grid.Column="2" Tag="Artist" Click="OnTrackColumnSort" Style="{StaticResource FlatButton}" HorizontalContentAlignment="Left"><TextBlock x:Name="DetailTrackArtistHeaderText" Text="Artist" Foreground="{ThemeResource MutedTextBrush}" FontSize="12" FontWeight="SemiBold"/></Button>
                                <Button Grid.Column="3" Tag="Album" Click="OnTrackColumnSort" Style="{StaticResource FlatButton}" HorizontalContentAlignment="Left"><TextBlock x:Name="DetailTrackAlbumHeaderText" Text="Album" Foreground="{ThemeResource MutedTextBrush}" FontSize="12" FontWeight="SemiBold"/></Button>
                                <Button Grid.Column="4" Tag="Duration" Click="OnTrackColumnSort" Style="{StaticResource FlatButton}" HorizontalContentAlignment="Right"><TextBlock x:Name="DetailTrackDurationHeaderText" Text="Duration" Foreground="{ThemeResource MutedTextBrush}" FontSize="12" FontWeight="SemiBold"/></Button>
                            </Grid>
                            <ListView x:Name="CustomOrderListView" Visibility="Collapsed" Background="Transparent" SelectionMode="None" CanDragItems="True" CanReorderItems="True" AllowDrop="True" DragItemsCompleted="OnCustomPlaylistReordered">
                                <ListView.ItemTemplate><DataTemplate>
                                    <Grid Padding="7" Margin="0,1" ColumnDefinitions="44,2*,1.4*,1.4*,70,42" Tapped="OnTrackTapped">
                                        <Border Width="38" Height="38" CornerRadius="5" Background="{ThemeResource Surface2Brush}"><Image Source="{Binding ArtworkUri}" Stretch="UniformToFill"/></Border>
                                        <TextBlock Grid.Column="1" Margin="12,0,0,0" Text="{Binding Title}" Foreground="{ThemeResource PrimaryTextBrush}" FontSize="16" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" PointerEntered="OnLinkTextHover" PointerExited="OnLinkTextUnhover"/>
                                        <Button Grid.Column="2" Tag="{Binding}" Click="OnArtistClick" PointerEntered="OnArtistHover" PointerExited="OnArtistUnhover" Style="{StaticResource ArtistButton}" Padding="0" Height="36" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"><TextBlock Text="{Binding Artist}" Foreground="{ThemeResource MutedTextBrush}" FontSize="15" TextTrimming="CharacterEllipsis"/></Button>
                                        <Button Grid.Column="3" Tag="{Binding}" Click="OnAlbumClick" PointerEntered="OnArtistHover" PointerExited="OnArtistUnhover" Style="{StaticResource NoHoverButton}" Padding="0" Height="36" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"><TextBlock Text="{Binding Album}" Foreground="{ThemeResource MutedTextBrush}" FontSize="15" TextTrimming="CharacterEllipsis"/></Button><TextBlock Grid.Column="4" Text="{Binding DurationText}" Foreground="{ThemeResource MutedTextBrush}" VerticalAlignment="Center" HorizontalAlignment="Right"/><Button Grid.Column="5" Style="{StaticResource IconButton}" Tag="{Binding}" Click="OnTrackMenu" Width="36" Height="36"><FontIcon Glyph="" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{ThemeResource SecondaryTextBrush}"/></Button>
                                    </Grid>
                                </DataTemplate></ListView.ItemTemplate>
                            </ListView>
                            <ItemsControl x:Name="StandardCollectionList">
                                <ItemsControl.ItemTemplate><DataTemplate>
                                    <Grid Padding="7" Margin="0,1" ColumnDefinitions="44,2*,1.4*,1.4*,70,42" Tapped="OnTrackTapped">
                                        <Border Width="38" Height="38" CornerRadius="5" Background="{ThemeResource Surface2Brush}"><Image Source="{Binding ArtworkUri}" Stretch="UniformToFill"/></Border>
                                        <TextBlock Grid.Column="1" Margin="12,0,0,0" Text="{Binding Title}" Foreground="{ThemeResource PrimaryTextBrush}" FontSize="16" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" PointerEntered="OnLinkTextHover" PointerExited="OnLinkTextUnhover"/>
                                        <Button Grid.Column="2" Tag="{Binding}" Click="OnArtistClick" PointerEntered="OnArtistHover" PointerExited="OnArtistUnhover" Style="{StaticResource ArtistButton}" Padding="0" Height="36" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"><TextBlock Text="{Binding Artist}" Foreground="{ThemeResource MutedTextBrush}" FontSize="15" TextTrimming="CharacterEllipsis"/></Button>
                                        <Button Grid.Column="3" Tag="{Binding}" Click="OnAlbumClick" PointerEntered="OnArtistHover" PointerExited="OnArtistUnhover" Style="{StaticResource NoHoverButton}" Padding="0" Height="36" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"><TextBlock Text="{Binding Album}" Foreground="{ThemeResource MutedTextBrush}" FontSize="15" TextTrimming="CharacterEllipsis"/></Button>
                                        <TextBlock Grid.Column="4" Text="{Binding DurationText}" Foreground="{ThemeResource MutedTextBrush}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                        <Button Grid.Column="5" Style="{StaticResource IconButton}" Tag="{Binding}" Click="OnTrackMenu" Width="36" Height="36"><FontIcon Glyph="" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{ThemeResource SecondaryTextBrush}"/></Button>
                                    </Grid>
                                </DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- custom plus menu -->
            <!-- Zero-size anchor for the floating add actions.  Because this host has no
                 visible area of its own, there is no panel/background connecting the buttons. -->
            <Canvas x:Name="AddMenu" Grid.Row="1" Width="0" Height="0" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,8,76" Visibility="Collapsed">
                <Button Width="136" Height="40" Canvas.Left="-136" Canvas.Top="-132" Style="{StaticResource SmallAction}" Background="{ThemeResource Surface2Brush}" Click="OnImportSongsMenu" HorizontalContentAlignment="Left"><StackPanel Orientation="Horizontal" Spacing="10"><FontIcon Glyph="" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{ThemeResource SecondaryTextBrush}"/><TextBlock Text="Import songs" VerticalAlignment="Center"/></StackPanel></Button>
                <Button Width="136" Height="40" Canvas.Left="-136" Canvas.Top="-86" Style="{StaticResource SmallAction}" Background="{ThemeResource Surface2Brush}" Click="OnImportFolderMenu" HorizontalContentAlignment="Left"><StackPanel Orientation="Horizontal" Spacing="10"><FontIcon Glyph="" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{ThemeResource SecondaryTextBrush}"/><TextBlock Text="Import folder" VerticalAlignment="Center"/></StackPanel></Button>
                <Button Width="136" Height="40" Canvas.Left="-136" Canvas.Top="-40" Style="{StaticResource SmallAction}" Background="{ThemeResource Surface2Brush}" Click="OnCreatePlaylistMenu" HorizontalContentAlignment="Left"><StackPanel Orientation="Horizontal" Spacing="10"><FontIcon Glyph="" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{ThemeResource SecondaryTextBrush}"/><TextBlock Text="Create playlist" VerticalAlignment="Center"/></StackPanel></Button>
            </Canvas>

            <Button x:Name="AddButton" Style="{StaticResource FlatButton}" Grid.Row="1" Width="54" Height="54" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,8,10" Background="{ThemeResource AccentBrush}" BorderThickness="0" CornerRadius="27" Click="OnImportMenu">
                <FontIcon Glyph="" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{ThemeResource PrimaryTextBrush}"/>
            </Button>
        </Grid>

        <!-- Queue drawer -->
        <Border x:Name="QueuePanel" Grid.Row="0" Grid.Column="1" Width="380" HorizontalAlignment="Right" Background="{ThemeResource SurfaceBrush}" BorderBrush="{ThemeResource AccentBrush}" BorderThickness="1,0,0,0" Visibility="Collapsed" Padding="20">
            <Grid RowDefinitions="Auto,*,Auto">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel><TextBlock Text="Queue" Foreground="{ThemeResource PrimaryTextBrush}" FontSize="22" FontWeight="SemiBold"/><TextBlock x:Name="QueueSubtitle" Text="Now playing and next" Foreground="{ThemeResource MutedTextBrush}" FontSize="16" Margin="0,3,0,0"/></StackPanel>
                    <Button Grid.Column="1" Style="{StaticResource IconButton}" Click="OnQueue" Width="36" Height="36"><FontIcon Glyph="" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{ThemeResource PrimaryTextBrush}"/></Button>
                </Grid>
                <ListView Grid.Row="1" x:Name="QueueList" Margin="0,16,0,10" Background="Transparent" SelectionMode="None" CanReorderItems="True" AllowDrop="True" DragItemsCompleted="OnQueueReordered">
                    <ListView.ItemTemplate><DataTemplate>
                        <Grid Padding="6" ColumnDefinitions="34,*,38" Margin="0,2" Tapped="OnQueueItemTapped" RightTapped="OnQueueItemRightTapped">
                            <Border Width="32" Height="32" CornerRadius="4" Background="{ThemeResource Surface3Brush}"><Image Source="{Binding ArtworkUri}" Stretch="UniformToFill"/></Border>
                            <StackPanel Grid.Column="1" Margin="10,0,0,0"><TextBlock Text="{Binding Title}" Foreground="{ThemeResource PrimaryTextBrush}" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Artist}" Foreground="{ThemeResource MutedTextBrush}" FontSize="11" TextTrimming="CharacterEllipsis"/></StackPanel>
                            <TextBlock Grid.Column="2" Text="{Binding DurationText}" Foreground="{ThemeResource MutedTextBrush}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                        </Grid>
                    </DataTemplate></ListView.ItemTemplate>
                </ListView>
                <StackPanel Grid.Row="2" Spacing="8">

                    <Button Style="{StaticResource SmallAction}" Click="OnClearQueue" HorizontalAlignment="Left"><TextBlock Text="Clear queue"/></Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Settings overlay -->
        <Border x:Name="SettingsPanel" Grid.Row="0" Grid.Column="1" Background="{ThemeResource AppBackgroundBrush}" Visibility="Collapsed" Padding="34">
            <ScrollViewer><StackPanel Width="520" HorizontalAlignment="Left" Spacing="18">
                <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Settings" Foreground="{ThemeResource PrimaryTextBrush}" FontSize="30" FontWeight="SemiBold"/><Button Grid.Column="1" Style="{StaticResource IconButton}" Click="OnCloseSettings" Width="38" Height="38"><FontIcon Glyph="" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{ThemeResource PrimaryTextBrush}"/></Button></Grid>
                <TextBlock Text="Appearance" Foreground="{ThemeResource MutedTextBrush}" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,0"/>
                <Border Background="{ThemeResource SurfaceBrush}" CornerRadius="12" Padding="16"><StackPanel Spacing="14">
                    <TextBlock Text="Accent color" Foreground="{ThemeResource PrimaryTextBrush}" FontSize="16"/>
                    <StackPanel x:Name="AccentOptionsPanel" Orientation="Horizontal" Spacing="10"/>
                    <TextBlock Text="Theme" Foreground="{ThemeResource PrimaryTextBrush}" FontSize="16" Margin="0,8,0,0"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Tag="Dark" Style="{StaticResource SmallAction}" Click="OnThemeButton"><TextBlock Text="Dark"/></Button>
                        <Button Tag="Light" Style="{StaticResource SmallAction}" Click="OnThemeButton"><TextBlock Text="Light"/></Button>
                    </StackPanel>
                </StackPanel></Border>
                <TextBlock Text="Library" Foreground="{ThemeResource MutedTextBrush}" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,0"/>
                <Border Background="{ThemeResource SurfaceBrush}" CornerRadius="12" Padding="16"><StackPanel Spacing="10">
                    <TextBlock Text="Managed library" Foreground="{ThemeResource PrimaryTextBrush}" FontSize="16"/>
                    <TextBlock Text="MyMusic copies imported files here. Original files are never moved or deleted." Foreground="{ThemeResource MutedTextBrush}" TextWrapping="Wrap"/>
                    <TextBlock x:Name="LibraryLocationText" Foreground="{ThemeResource SecondaryTextBrush}" FontSize="13" TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="ChangeLibraryLocationButton" Style="{StaticResource SmallAction}" Click="OnChangeLibraryLocation"><TextBlock Text="Change location"/></Button>
                        <Button Style="{StaticResource SmallAction}" Click="OnOpenLibraryFolder"><TextBlock Text="Open library folder"/></Button>
                    </StackPanel>
                    <TextBlock x:Name="LibraryLocationStatus" Visibility="Collapsed" Foreground="{ThemeResource MutedTextBrush}" FontSize="13" TextWrapping="Wrap"/>
                </StackPanel></Border>
                </StackPanel></ScrollViewer>
        </Border>

        <!-- Track editor overlay -->
        <Grid x:Name="EditTrackOverlay" Grid.Row="0" Grid.Column="0" Grid.RowSpan="2" Grid.ColumnSpan="2" Canvas.ZIndex="20" Visibility="Collapsed" Background="{ThemeResource AppBackgroundBrush}">
            <Grid Margin="44,30,44,34" RowDefinitions="Auto,*,Auto">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel>
                        <TextBlock Text="Edit song" FontSize="30" FontWeight="SemiBold" Foreground="{ThemeResource PrimaryTextBrush}"/>
                        <TextBlock Text="Edit library metadata and cover art" Margin="0,5,0,0" FontSize="13" Foreground="{ThemeResource MutedTextBrush}"/>
                    </StackPanel>
                    <Button Grid.Column="1" Style="{StaticResource IconButton}" Click="OnCancelTrackEdit" Width="40" Height="40">
                        <FontIcon Glyph="" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{ThemeResource PrimaryTextBrush}"/>
                    </Button>
                </Grid>

                <ScrollViewer Grid.Row="1" Margin="0,24,0,18" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="24" MaxWidth="980" HorizontalAlignment="Left">
                        <Grid ColumnDefinitions="300,*" ColumnSpacing="30">
                            <StackPanel Spacing="12">
                                <Border Width="280" Height="280" CornerRadius="12" Background="{ThemeResource Surface2Brush}">
                                    <Image x:Name="EditArtworkPreview" Stretch="UniformToFill"/>
                                </Border>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Style="{StaticResource SmallAction}" Click="OnUploadEditArtwork"><TextBlock Text="Upload new cover"/></Button>
                                    <Button Style="{StaticResource SmallAction}" Click="OnToggleCropControls"><TextBlock Text="Crop cover"/></Button>
                                </StackPanel>
                                <Border x:Name="EditCropPanel" Visibility="Collapsed" Background="{ThemeResource SurfaceBrush}" CornerRadius="10" Padding="12">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="Crop position" FontWeight="SemiBold" Foreground="{ThemeResource PrimaryTextBrush}"/>
                                        <TextBlock Text="Horizontal" FontSize="12" Foreground="{ThemeResource MutedTextBrush}"/>
                                        <Slider x:Name="EditCropX" Minimum="0" Maximum="100" Value="50"/>
                                        <TextBlock Text="Vertical" FontSize="12" Foreground="{ThemeResource MutedTextBrush}"/>
                                        <Slider x:Name="EditCropY" Minimum="0" Maximum="100" Value="50"/>
                                        <TextBlock Text="Zoom" FontSize="12" Foreground="{ThemeResource MutedTextBrush}"/>
                                        <Slider x:Name="EditCropZoom" Minimum="1" Maximum="3" Value="1" StepFrequency="0.05"/>
                                        <Button Style="{StaticResource SmallAction}" HorizontalAlignment="Left" Click="OnApplyArtworkCrop"><TextBlock Text="Apply crop"/></Button>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Spacing="15" VerticalAlignment="Top">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="Song name" Foreground="{ThemeResource MutedTextBrush}" FontSize="13"/>
                                    <Border Background="{ThemeResource Surface2Brush}" BorderBrush="{ThemeResource SectionBorderBrush}" BorderThickness="1" CornerRadius="9" Padding="10,0" Height="46">
                                        <TextBox x:Name="EditTitleBox" Style="{StaticResource SearchTextBox}" Height="42" VerticalAlignment="Center" Background="Transparent" BorderThickness="0" Foreground="{ThemeResource PrimaryTextBrush}"/>
                                    </Border>
                                </StackPanel>
                                <StackPanel Spacing="6">
                                    <TextBlock Text="Artist" Foreground="{ThemeResource MutedTextBrush}" FontSize="13"/>
                                    <Border Background="{ThemeResource Surface2Brush}" BorderBrush="{ThemeResource SectionBorderBrush}" BorderThickness="1" CornerRadius="9" Padding="10,0" Height="46">
                                        <TextBox x:Name="EditArtistBox" Style="{StaticResource SearchTextBox}" Height="42" VerticalAlignment="Center" Background="Transparent" BorderThickness="0" Foreground="{ThemeResource PrimaryTextBrush}"/>
                                    </Border>
                                </StackPanel>
                                <StackPanel Spacing="6">
                                    <TextBlock Text="Album" Foreground="{ThemeResource MutedTextBrush}" FontSize="13"/>
                                    <Border Background="{ThemeResource Surface2Brush}" BorderBrush="{ThemeResource SectionBorderBrush}" BorderThickness="1" CornerRadius="9" Padding="10,0" Height="46">
                                        <TextBox x:Name="EditAlbumBox" Style="{StaticResource SearchTextBox}" Height="42" VerticalAlignment="Center" Background="Transparent" BorderThickness="0" Foreground="{ThemeResource PrimaryTextBrush}"/>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <StackPanel Spacing="10">
                            <TextBlock Text="Recently imported or edited" FontSize="18" FontWeight="SemiBold" Foreground="{ThemeResource PrimaryTextBrush}"/>
                            <TextBlock Text="Copy cover, artist, and album from a recent song. The song name is never copied." FontSize="12" Foreground="{ThemeResource MutedTextBrush}"/>
                            <ItemsControl x:Name="EditRecentTracks">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{ThemeResource SurfaceBrush}" CornerRadius="9" Padding="10" Margin="0,0,0,6">
                                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                                <Border Width="48" Height="48" CornerRadius="5" Background="{ThemeResource Surface2Brush}"><Image Source="{Binding ArtworkUri}" Stretch="UniformToFill"/></Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Title}" FontSize="14" Foreground="{ThemeResource PrimaryTextBrush}" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Artist}" FontSize="12" Foreground="{ThemeResource MutedTextBrush}" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Album}" FontSize="11" Foreground="{ThemeResource MutedTextBrush}" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                                <Button Grid.Column="2" Tag="{Binding}" Style="{StaticResource SmallAction}" Click="OnCopyRecentTrackInfo" VerticalAlignment="Center"><TextBlock Text="Copy info"/></Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <Grid Grid.Row="2" ColumnDefinitions="*,Auto">
                    <TextBlock x:Name="EditTrackStatus" VerticalAlignment="Center" Foreground="{ThemeResource MutedTextBrush}" FontSize="12"/>
                    <Button Grid.Column="1" Background="{ThemeResource AccentBrush}" Foreground="White" BorderThickness="0" CornerRadius="9" Padding="24,11" Click="OnSaveTrackEdit"><TextBlock Text="Save" FontWeight="SemiBold"/></Button>
                </Grid>
            </Grid>
        </Grid>

        <!-- bottom player -->
        <Border x:Name="PlayerBar" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Canvas.ZIndex="2" Background="{ThemeResource SidebarBrush}" BorderBrush="{ThemeResource Surface3Brush}" BorderThickness="0,1,0,0" Padding="18,10">
            <Grid ColumnDefinitions="280,*,270">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="11">
                    <Border Width="52" Height="52" CornerRadius="6" Background="{ThemeResource Surface2Brush}"><Image x:Name="NowPlayingArtwork" Stretch="UniformToFill"/></Border>
                    <StackPanel VerticalAlignment="Center" Width="200"><TextBlock x:Name="NowPlayingTitle" Text="Nothing playing" Foreground="{ThemeResource PrimaryTextBrush}" FontSize="13" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="NowPlayingArtist" Text="" Foreground="{ThemeResource MutedTextBrush}" FontSize="11" TextTrimming="CharacterEllipsis"/></StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" Width="460">
                    <Grid Height="60" HorizontalAlignment="Center" ColumnDefinitions="40,40,60,40,40">
                        <Grid Grid.Column="0" Width="38" Height="38">
                            <Button x:Name="ShuffleButton" Style="{StaticResource FlatButton}" Click="OnShuffle" Width="32" Height="32"><FontIcon Glyph="" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{ThemeResource SecondaryTextBrush}"/></Button>
                            <Ellipse x:Name="ShuffleDot" Width="4" Height="4" Fill="{ThemeResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,1" Visibility="Collapsed"/>
                        </Grid>
                        <Button Grid.Column="1" Style="{StaticResource FlatButton}" Click="OnPrevious" Width="32" Height="32"><FontIcon Glyph="" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{ThemeResource SecondaryTextBrush}"/></Button>
                        <Button Grid.Column="2" x:Name="PlayPauseButton" Style="{StaticResource NoHoverButton}" Width="56" Height="56" Background="{ThemeResource AccentBrush}" BorderThickness="0" CornerRadius="28" Click="OnPlayPause"><Grid Width="28" Height="28"><FontIcon x:Name="PlayIcon" Glyph="" FontFamily="Segoe MDL2 Assets" FontSize="24" Foreground="{ThemeResource PrimaryTextBrush}"/><FontIcon x:Name="PauseIcon" Glyph="" FontFamily="Segoe MDL2 Assets" FontSize="22" Foreground="{ThemeResource PrimaryTextBrush}" Visibility="Collapsed"/></Grid></Button>
                        <Button Grid.Column="3" Style="{StaticResource FlatButton}" Click="OnNext" Width="36" Height="36"><FontIcon Glyph="" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{ThemeResource SecondaryTextBrush}"/></Button>
                        <Grid Grid.Column="4" Width="38" Height="38">
                            <Button x:Name="RepeatButton" Style="{StaticResource FlatButton}" Click="OnRepeat" Width="32" Height="32"><FontIcon Glyph="" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{ThemeResource SecondaryTextBrush}"/></Button>
                            <Ellipse x:Name="RepeatDot" Width="4" Height="4" Fill="{ThemeResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,1" Visibility="Collapsed"/>
                        </Grid>
                    </Grid>
                    <Grid ColumnDefinitions="40,*,40" Height="24" MaxWidth="390">
                        <TextBlock x:Name="CurrentTimeText" Text="0:00" Foreground="{ThemeResource MutedTextBrush}" FontSize="11" VerticalAlignment="Center"/>
                        <Canvas x:Name="ProgressCanvas" Grid.Column="1" Height="24" VerticalAlignment="Center" Background="Transparent" SizeChanged="OnProgressCanvasSizeChanged" PointerPressed="OnProgressPointerPressed" PointerMoved="OnProgressPointerMoved" PointerReleased="OnProgressPointerReleased">
                            <Border x:Name="ProgressTrack" Height="5" Width="0" Canvas.Top="9" CornerRadius="3" Background="{ThemeResource Surface3Brush}" Opacity="1"/>
                            <Border x:Name="ProgressFill" Height="5" Width="0" Canvas.Top="9" CornerRadius="3" Background="{ThemeResource AccentBrush}"/>
                            <Ellipse x:Name="ProgressPlayhead" Width="12" Height="12" Canvas.Top="5" Fill="{ThemeResource AccentBrush}"/>
                        </Canvas>
                        <TextBlock x:Name="TotalTimeText" Grid.Column="2" Text="0:00" Foreground="{ThemeResource MutedTextBrush}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="10">
                    <Button x:Name="CastingButton" Style="{StaticResource FlatButton}" Click="OnCastingButton" Width="36" Height="36" Padding="0">
                        <FontIcon x:Name="CastingIcon" Glyph="" FontFamily="Segoe MDL2 Assets" FontSize="18" Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{ThemeResource SecondaryTextBrush}"/>
                        <Button.Flyout>
                            <Flyout x:Name="CastingFlyout" Placement="Top">
                                <Border Width="330" MaxHeight="520" Padding="16" Background="{ThemeResource SurfaceBrush}" CornerRadius="14">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <StackPanel Spacing="10">
                                            <TextBlock Text="Audio devices" FontSize="18" FontWeight="SemiBold" Foreground="{ThemeResource PrimaryTextBrush}"/>
                                            <TextBlock x:Name="CastingStatusText" Text="Not casting" FontSize="13" Foreground="{ThemeResource MutedTextBrush}" TextWrapping="Wrap"/>
                                            <Grid Margin="0,4,0,0">
                                                <TextBlock Text="Chromecast" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource PrimaryTextBrush}"/>
                                                <ProgressRing x:Name="CastDeviceLoading" Width="16" Height="16" IsActive="True" HorizontalAlignment="Right"/>
                                            </Grid>
                                            <StackPanel x:Name="CastDeviceListPanel" Spacing="2"/>
                                            <Border Height="1" Background="{ThemeResource Surface3Brush}" Margin="0,5"/>
                                            <Grid>
                                                <TextBlock Text="Bluetooth &amp; audio outputs" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource PrimaryTextBrush}"/>
                                                <ProgressRing x:Name="AudioDeviceLoading" Width="16" Height="16" IsActive="True" HorizontalAlignment="Right"/>
                                            </Grid>
                                            <TextBlock Text="Bluetooth speakers and headphones must first be paired with Windows." FontSize="11" Foreground="{ThemeResource MutedTextBrush}" TextWrapping="Wrap"/>
                                            <StackPanel x:Name="AudioDeviceListPanel" Spacing="2"/>
                                            <Button x:Name="StopCastingButton" Style="{StaticResource SmallAction}" Click="OnStopCasting" HorizontalAlignment="Stretch" Visibility="Collapsed" Margin="0,6,0,0">
                                                <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="" FontFamily="Segoe MDL2 Assets"/><TextBlock Text="Stop Chromecast"/></StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </ScrollViewer>
                                </Border>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                    <Button x:Name="FullscreenButton" Style="{StaticResource FlatButton}" Click="OnFullscreenButton" Width="34" Height="34"><FontIcon Glyph="" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{ThemeResource SecondaryTextBrush}"/></Button>
                    <Button x:Name="QueuePlayerButton" Style="{StaticResource FlatButton}" Click="OnQueue" PointerEntered="OnQueueHover" PointerExited="OnQueueUnhover" Width="34" Height="34"><FontIcon Glyph="" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{ThemeResource SecondaryTextBrush}"/></Button>
                    <Canvas x:Name="VolumeCanvas" Width="130" Height="24" VerticalAlignment="Center" PointerPressed="OnVolumePointerPressed" PointerMoved="OnVolumePointerMoved" PointerReleased="OnVolumePointerReleased">
                        <Button x:Name="VolumeButton" Canvas.Left="0" Canvas.Top="0" Width="20" Height="24" Padding="0" Background="Transparent" BorderThickness="0" Click="OnVolumeIconClick" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"><FontIcon x:Name="VolumeIcon" Glyph="" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{ThemeResource SecondaryTextBrush}"/></Button>
                        <Border x:Name="VolumeTrack" Height="5" Width="100" Canvas.Left="25" Canvas.Top="9" CornerRadius="3" Background="{ThemeResource Surface3Brush}"/>
                        <Border x:Name="VolumeFill" Height="5" Width="100" Canvas.Left="25" Canvas.Top="9" CornerRadius="3" Background="{ThemeResource AccentBrush}"/>
                        <Ellipse x:Name="VolumePlayhead" Width="11" Height="11" Canvas.Top="6" Fill="{ThemeResource AccentBrush}"/>
                    </Canvas>
                </StackPanel>
            </Grid>
        </Border>


        <!-- fullscreen now-playing surface; the normal app remains underneath it -->
        <Grid x:Name="FullscreenOverlay" Grid.Row="0" Grid.Column="0" Grid.RowSpan="2" Grid.ColumnSpan="2" Canvas.ZIndex="1" Visibility="Collapsed" Background="{ThemeResource AppBackgroundBrush}">
            <Image x:Name="FullscreenArtwork" Width="480" Height="480" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <StackPanel x:Name="FullscreenTrackInfo" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="48,0,48,38" Spacing="5" Visibility="Collapsed">
                <TextBlock x:Name="FullscreenTitle" FontSize="24" FontWeight="Bold" Foreground="White" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="FullscreenArtist" FontSize="16" Foreground="#E6FFFFFF" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </Grid>

        <!-- bottom toast -->
        <Border x:Name="Toast" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Canvas.ZIndex="3" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="30,0,0,18" Background="{ThemeResource Surface2Brush}" BorderBrush="{ThemeResource AccentBrush}" BorderThickness="1" CornerRadius="10" Padding="14,10" Visibility="Collapsed">
            <TextBlock x:Name="ToastText" Foreground="{ThemeResource PrimaryTextBrush}" FontSize="13"/>
        </Border>
    </Grid>
</Window>